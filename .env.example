# Copia este archivo a ".env" y rellena los valores. ".env" NO se sube a Git.
# En un servidor (Render) estas mismas variables se ponen en su panel de
# "Environment", no en un archivo.

# --- Base de datos --------------------------------------------------------
# ¡OJO CON EL "+psycopg2"! NO es decorativo, hace falta.
#
# Esta app usa el driver psycopg2. SQLAlchemy 2.1 intenta usar psycopg (v3)
# cuando la URL no dice cuál usar, y como no está instalado la app no arranca.
# Escribiendo "+psycopg2" en la URL se le dice cuál es, y funciona igual en
# local y en Neon.
#
# Local (Docker): la que levanta docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@localhost:5432/trademind

# Produccion (Neon): copia la cadena que da Neon tal cual y AÑADELE
# "+psycopg2" despues de "postgresql":
#   postgresql+psycopg2://usuario:clave@ep-algo.neon.tech/db?sslmode=require
#
# Si la dejas como "postgresql://" a secas, desplegado NO arranca. Y en local
# sí arranca, así que no te vas a enterar hasta que falle en producción.

# Solo para docker-compose (el Postgres local). Deben coincidir con DATABASE_URL.
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=trademind

# --- Seguridad ------------------------------------------------------------
# Firma las sesiones. Obligatoria: sin ella la app se niega a arrancar.
# Genera una distinta para produccion con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- CORS -----------------------------------------------------------------
# Direcciones desde las que el navegador puede llamar a la API, separadas por
# comas y sin "/" al final. Vacio = solo localhost:3000 (desarrollo).
# En produccion: la direccion publica del frontend, por ejemplo
#   CORS_ORIGINS=https://trademind.com,https://www.trademind.com
CORS_ORIGINS=

# --- Frontend (esta variable NO va en este archivo) ------------------------
# Va en web/.env.local para desarrollo, o en el panel de Cloudflare en
# produccion. Se deja aqui documentada porque web/.gitignore ignora ".env*".
#
#   NEXT_PUBLIC_API_URL=https://api.trademind.com
#
# Direccion publica del backend, sin "/" al final. Si no se define, el frontend
# usa http://127.0.0.1:8000 (desarrollo local). OJO: Next.js la "pega" dentro
# del codigo al CONSTRUIR la web; en produccion hay que definirla ANTES de
# construir, y si se cambia despues hay que volver a construir.
